# .env.local にコピーして値を入れる(.env.local はGitに含めない)

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログインを許可するメールアドレス(カンマ区切り)
ALLOWED_EMAILS=

# Googleログインのボタンを出すか(SupabaseでGoogleを有効にしたら true)
NEXT_PUBLIC_GOOGLE_LOGIN=false

# マイグレーションとseed用(npm run db:migrate / db:seed)。Vercelには入れなくてよい
# Supabase → Connect → Session pooler の接続文字列([YOUR-PASSWORD] をDBパスワードに置き換える)
DATABASE_URL=

# 開発用テストユーザー(npm run db:test-user で作る。npm run dev のときだけログイン画面に出る)。
# 使うときは ALLOWED_EMAILS にも足す。本番(Vercel)には入れない
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
